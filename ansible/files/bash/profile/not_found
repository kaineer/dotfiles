#!/usr/bin/env bash

command_not_found_handle() {
  # $1 - имя команды
  # $@ - все аргументы, включая имя команды

  LAT="abcdefghijklmnopqrstuvwxyz"
  RUS="фисвуапршолдьтщзйкыегмцчня"

  LC=$(sed "y|${RUS}|${LAT}|" <<<"$1")
  if [[ "$1" != "$LC" ]]; then
    if command -v "$LC" &>/dev/null; then
      shift
      ### command вызывает встроенную команду
      # command "$LC" "$@"
      eval "$LC" "$@"
      return $?
    else
      echo "Команды $1 здесь нет"
      echo "      и $LC тоже"
      return 127
    fi
  fi

  echo "Команды $1 здесь нет"

  # Возвращаем 127, как это делает Bash по умолчанию,
  # если мы не можем обработать команду.
  return 127
}
