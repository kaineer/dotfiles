// Zed editor settings
{
  "agent_servers": {
    "Qwen Code": {
      "type": "custom",
      "command": "qwen",
      "args": ["--acp"],
      "env": {}
    }
  },
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Zed (Default)",
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "cli_default_open_behavior": "new_window",
  "project_panel": {
    "dock": "left",
  },
  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": null,
  },
  "git_panel": {
    "dock": "left",
  },
  "language_models": {
    "ollama": {
      "api_url": "http://localhost:8000",
      "available_models": [
        {
          "name": "qwen2.5-coder:7b",
          "display_name": "Qwen 2.5 coder",
          "max_tokens": 32768,
          "supports_tools": true
        }
      ]
    },
  },
  "edit_predictions": {
    "open_ai_compatible_api": {
      "api_url": "http://localhost:8000/v1",
      "prompt_format": "qwen"
    },
    "ollama": {
      "prompt_format": "qwen",
      "api_url": "http://localhost:8000"
    },
    "provider": "ollama",
  },
  "lsp": {
    "vtsls": {
      "settings": {
        "typescript": {
          "updateImportsOnFileMove": {
            "enabled": "always",
          },
        },
        "javascript": {
          "updateImportsOnFileMove": {
            "enabled": "always",
          },
        },
      },
      "enable_lsp_tasks": true,
    },
  },
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Nordic Syntax",
  },
  "vim_mode": false,
  "agent": {
    "thinking_display": "preview",
    "play_sound_when_agent_done": "always",
    "profiles": {
      "write": {
        "name": "Write",
        "tools": {
          "copy_path": true,
          "create_directory": true,
          "create_thread": true,
          "delete_path": true,
          "diagnostics": true,
          "apply_code_action": true,
          "ask_user": true,
          "edit_file": true,
          "write_file": true,
          "fetch": true,
          "find_path": true,
          "find_references": true,
          "get_code_actions": true,
          "go_to_definition": true,
          "list_agents_and_models": true,
          "list_directory": true,
          "move_path": true,
          "rename_symbol": true,
          "read_file": true,
          "grep": true,
          "skill": true,
          "spawn_agent": true,
          "terminal": true,
          "search_web": true
        },
        "enable_all_context_servers": true,
        "context_servers": {}
      }
    },
    "tool_permissions": {
      "default": "allow",
      "tools": {
        "search_web": {
          "default": "confirm"
        },
        "create_directory": {
          "default": "confirm"
        },
        "delete_path": {
          "default": "confirm"
        },
        "terminal": {
          "default": "allow",
        },
        "list_directory": {
          "default": "allow",
        },
        "read_file": {
          "default": "allow",
        },
        "write_file": {
          "default": "allow",
        },
        "edit_file": {
          "default": "confirm",
        },
      },
    },
    "enabled": true,
    "dock": "right",
    "default_profile": "write",
    "default_model": {
      "provider": "ollama",
      "model": "qwen2.5-coder:7b",
      "enable_thinking": false,
    },
    "favorite_models": [],
    "model_parameters": [],
  },
  "buffer_font_family": "FiraCode Nerd Font",
  "buffer_font_size": 16,
  "terminal": {
    "font_family": "FiraCode Nerd Font",
    "font_size": 16,
  },
  "tab_bar": { "show": false },
  "file_scan_exclusions": ["ai/responses/**/*.md"],
  "tab_size": 2,
  "languages": {
    "Python": {
      "tab_size": 4,
      "hard_tabs": false,
    },
  },
}
