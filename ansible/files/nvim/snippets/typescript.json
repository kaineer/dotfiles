      "  name: '${1}',",
      "  initialState,",
      "  reducers: {},",
      "})"
    ],
    "description": "Slice skeleton"
  },
  "sliceItem": {
    "prefix": "sliceItem",
    "body": [
      "[${1}Slice.reducerPath]: ${1}Slice.reducer,"
    ],
    "description": "Slice item in store"
  },
  "component": {
    "prefix": "component",
