    "ctrl-shift-tab": "tab.prev",
    "ctrl-space ctrl-n": "space.next",
    "ctrl-space ctrl-p": "space.prev",
    "ctrl-?": "app.help",
    "ctrl-shift-/": "app.help",
    "ctrl-shift-?": "app.help",
    "ctrl-shift-n": "space.new",
    "ctrl-space s": "space.new",
