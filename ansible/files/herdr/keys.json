    "ctrl-space t r": "tab.rename",
    "ctrl-space ctrl-v": {
      "command": "pane.split",
      "args": {
        "direction": "right",
        "argv": [
          "/home/kaineer/bin/nvim",
          "+Telescope find_files"
        ]
      }
    },
    "ctrl-space ctrl-y": {
      "command": "pane.split",
      "args": {
        "direction": "right",
        "argv": [
          "/home/kaineer/bin/.cargo/bin/yazi",
          "."
        ]
      }
    },
    "ctrl-space ctrl-a": {
      "command": "pane.split",
      "args": {
        "direction": "right",
        "argv": [
          "/home/kaineer/.local/bin/agent",
          "--continue"
        ]
      }
    },
    "ctrl-space a": {
      "command": "pane.split",
      "args": {
        "direction": "right",
        "argv": [
          "/home/kaineer/.local/bin/agent"
        ]
      }
    },
    "f2": "tab.rename",
    "shift-f2": "space.rename",
    "ctrl-shift-o": "mod.open:on-screen"
