{
  "global": {
    "ctrl-space ctrl-1": "space.select:1",
    "ctrl-space ctrl-2": "space.select:2",
    "ctrl-space ctrl-3": "space.select:3",
    "ctrl-space ctrl-4": "space.select:4",
    "ctrl-space ctrl-5": "space.select:5",
    "ctrl-space ctrl-6": "space.select:6",
    "ctrl-space ctrl-7": "space.select:7",
