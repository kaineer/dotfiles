__tmux_usage() {
    echo " $ t h  -- help"
    echo " $ t d  -- tmux detach"
    echo " $ t x  -- tmux kill-server"
    echo " $ t s  -- tmux rename-session ..."
    echo " $ t w  -- tmux rename-window ..."
    echo " $ t kw -- tmux kill-window"
    echo " $ t j  -- select window and switch to it"
    echo " $ t a <session-name> -- tmux attach -t <session-name>"
    echo " $ t ks <session-name> -- tmux kill-session -t <session-name>"
    echo " $ t <tmux-command>… -- execute tmux command"
    echo " $ t e -- edit config"
}

__jump() {
    TARGET=$(tmux lsw -a -F"#S:#W:#I" | fzf)
    if [[ "$TARGET" != "" ]]; then
        T_SESSION=$(echo $TARGET | cut -f1 -d:)
        T_WINDOW_ID=$(echo $TARGET | cut -f3 -d:)
        tmux switch-client -t "$T_SESSION:$T_WINDOW_ID"
    fi
}

__jump_session() {
    TARGET=$(tmux ls -F"#S" | fzf -1)
    if [[ "$TARGET" != "" ]]; then
        if [[ "$TMUX" == "" ]]; then
            tmux attach -t $TARGET
        else
            tmux switch-client -t "$TARGET"
        fi
    fi
}

__list_commands() {
    echo "help"
    echo "detach"
    echo "jump"
    echo "quit"
    echo "dev"
    echo "teach"
    echo "media"
    echo "learn"
}

complete -W "help jump detach quit dev teach media rename-session rename-window" t

__fzf_command() {
    CMD=$(__list_commands | fzf)
    [[ "$CMD" != "" ]] && t $CMD
}

__outside_tmux() {
    [[ "$TMUX" == "" ]]
}

__session_exists() {
    tmux has -t "$1" &>/dev/null
}

__edit_pane() {
  F=".tmux/$1.sh"
  mkdir -p .tmux
  $EDITOR $F
  [ -f "$F" ] && chmod 755 $F
}

__four_panes() {
    if [[ "$1" == "x" ]]; then
      IDX=$(tmux display-message -p '#{pane_index}')
      if [ -f ".tmux/$IDX.sh" ]; then
        . ./.tmux/$IDX.sh
        return 0
      fi
    elif [[ "$1" == "e" ]]; then
      IDX=$(tmux display-message -p '#{pane_index}')
      if [ -f ".tmux/$IDX.sh" ]; then
        e ./.tmux/$IDX.sh
        return 0
      fi
    fi

    if [[ "$1" != "" ]]; then
      __edit_pane $1
      return 0
    fi

    local pane_count=$(tmux list-panes | wc -l)
    
    if [ "$pane_count" -ne 1 ]; then
        echo "Working only in one-pane window"
        return 1
    fi
    
    # Сохраняем ID текущего pane
    local current=$(tmux display-message -p '#{pane_id}')
    
    # Разделяем по вертикали, получаем ID нового pane
    local right=$(tmux split-window -h -t "$current" -P -F '#{pane_id}')
    
    # Разделяем каждый по горизонтали
    tmux split-window -v -t "$current"
    tmux split-window -v -t "$right"
}

__four_panes_x() {
    if [[ "$1" != "" ]]; then
        __edit_pane $1
        return 0
    fi

    if [ -z "$TMUX" ]; then
        echo "Works inside tmux only"
        return 1
    fi

    local pane_count=$(tmux list-panes | wc -l)
    if [ "$pane_count" -ne 1 ]; then
        echo "Does not work with more than one pane"
        return 1
    fi

    local dir="$PWD/.tmux"
    local p0=$(tmux display-message -p '#{pane_id}')

    # Команда для каждого pane (пустая строка = обычный shell)
    local cmd0=""; [ -f "$dir/0.sh" ] && cmd0="$dir/0.sh"
    local cmd1=""; [ -f "$dir/1.sh" ] && cmd1="$dir/1.sh"
    local cmd2=""; [ -f "$dir/2.sh" ] && cmd2="$dir/2.sh"
    local cmd3=""; [ -f "$dir/3.sh" ] && cmd3="$dir/3.sh"

    # Создаём pane сразу с командами.
    # Флаг -d (detached) подавляет переключение фокуса при создании —
    # это ускоряет работу и уменьшает мерцание.
    local p1=$(tmux split-window -h -d -t "$p0" $cmd1 -P -F '#{pane_id}')
    local p2=$(tmux split-window -v -d -t "$p0" $cmd2 -P -F '#{pane_id}')
    local p3=$(tmux split-window -v -d -t "$p1" $cmd3 -P -F '#{pane_id}')

    # Для исходного pane — только send-keys (его нельзя "пересоздать")
    [ -n "$cmd0" ] && tmux send-keys -t "$p0" "$cmd0" C-m

    tmux select-pane -t "$p0"
}

__move_and_switch() {
  if [ -z "$1" ]; then
    echo " $(ansi red)$(icon log error)$(ansi reset) $(ansi cyan)$ t mv <session-name>$(ansi reset)"
    echo "    provide session name"
    return 1
  else
    if ! __session_exists "$1"; then
      tmux new-session -d -s "$1"
      tmux kill-window -t "$1:0"
    fi

    tmux move-window -t "$1" && tmux switch-client -t "$1"
  fi
}

ta() {
  # $ ta <session-name> - attach to session, even if it does not exist
  #
  if [[ "$1" != "" ]]; then
    # there should be a session name
    SESSION="$1"

    if __session_exists "$SESSION"; then
      # session exists
      if __outside_tmux; then
        # > attach to session
        tmux attach -t "$SESSION"
      else
        # > switch to session
        tmux switch-client -t "$SESSION"
      fi
    else
      # no session created
      if __outside_tmux; then
        # > create session and join it
        tmux new -s "$SESSION"
      else
        # > create detached session
        # > switch to it
        tmux new -d -s "$SESSION"
        tmux switch-client -t "$SESSION"
      fi
    fi
  else
    __jump_session
  fi
}

__kill_sessions() {
    if [[ "$1" != "" ]]; then
        ERR_COUNT=$(tmux kill-session -t $1 2>&1 | grep "find session" | wc -l)
        if [[ "$ERR_COUNT" == "1" ]]; then
            echo " ! There is no session [${1}]"
        else
            echo " * Session [${1}] is terminated"
        fi
        shift
        if [[ "$1" != "" ]]; then
            __kill_sessions $@
        fi
    else
        for name in $(tmux ls -F"#S" | fzf -m); do
            tmux kill-session -t $name
        done
    fi
}

__list_windows() {
    tmux list-windows -F "#I -> #W"
}

__list_all_windows() {
    tmux list-windows -a -F "#S: #I -> #W"
}

t() {
    case "$1" in
    "h" | "help") __tmux_usage ;;
    "d" | "detach") tmux detach ;;
    "s" | "rename-session")
        shift
        tmux rename-session $@
        ;;
    "w" | "rename-window")
        shift
        tmux rename-window $@
        ;;
    "e" | "edit")
      te
      ;;
    "kw") tmux kill-window ;;
    "a" | "attach")
        shift
        __session_attach $@
        # tmux attach -t $@
        ;;
    "ks")
        shift
        __kill_sessions $@
        ;;
    "lsw") __list_windows ;;
    "lswa") __list_all_windows ;;
    "x" | "q" | "exit" | "quit") tmux kill-server ;;
    "j" | "jump") __jump ;;
    "4") shift; __four_panes $@ ;;
    "4x") __four_panes_x ;;
    "mv") shift; __move_and_switch $@ ;;
    "dev") ta dev ;;
    "teach") ta teach ;;
    "media") ta media ;;
    "learn") ta learn ;;
    "") __fzf_command ;;
    *) tmux "$@" ;;
    esac
}

te() {
  $EDITOR $TMUX_CFG/$TMUX_FILE
}

tw() {
    tmux select-window -t "$1"
}

th() {
    tmux split-window -h "$@"
}

tv() {
    tmux split-window -v "$@"
}
